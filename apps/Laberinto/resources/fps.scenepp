<?xml version="1.0" encoding="UTF-8"?>
<scene formatVersion="1.1">

  <userData>
    <property name="gravity" type="vector" data="0 -9.81 0"/>
  </userData>

  <environment>
    <colourAmbient r="0.035" g="0.04" b="0.065"/>
    <colourBackground r="0.008" g="0.01" b="0.018"/>
    <fog mode="exp2" density="0.07">
     <colour r="0.012" g="0.016" b="0.028"/>
    </fog>
  </environment>

  <nodes>
    <node name="Player" >
      <position x="0" y="0" z="1.7" />
      <camera fov="0.785398163" name="Player" projectionType="perspective" >
        <clipping far="10000" near="0.01" />
      </camera>

      <node name="l1n">
        <position x="0" y="-0.05" z="-0.15"/>
        <light name="l1" type="spot">
          <colourDiffuse r="0.8" g="0.7" b="0.5"/>
          <colourSpecular r="0.08" g="0.07" b="0.05"/>
          <lightRange inner="0.38" outer="0.72" falloff="1.2"/>
          <lightAttenuation range="9" constant="1" linear="0.18" quadratic="0.12"/>
        </light>
      </node>

      <userData>
        <property name="mass"       type="float" data="70"/>
        <property name="radius"     type="float" data="0.3"/>
        <property name="height"     type="float" data="1.7"/>
        <property name="eye_height" type="float" data="1.6"/>
        <property name="walk_speed" type="float" data="3"/>
      </userData>
    </node>

    <node name="Ground">
      <plane
          name="GroundPlane" distance="0" width="42" height="42"
          xSegments="21" ySegments="21" numTexCoordSets="1"
          uTile="21" vTile="21" hasNormals="true" material="Ground"
          >
        <normal x="0" y="1" z="0"/>
        <upVector x="0" y="0" z="-1"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>
    </node>

    <node name="Ceiling">
      <position x="0" y="3" z="0"/>
      <plane
          name="CeilingPlane" distance="0" width="42" height="42"
          xSegments="21" ySegments="21" numTexCoordSets="1"
          uTile="21" vTile="21" hasNormals="true" material="Ceiling"
          >
        <normal x="0" y="-1" z="0"/>
        <upVector x="0" y="0" z="1"/>
      </plane>
      <userData>
        <property name="mass" type="float" data="0"/>
      </userData>
    </node>

    <node name="MonsterPlaceholder">
      <position x="0" y="0.8" z="2"/>
      <parametricSurface name="MonsterPlaceholder" type="superEllipsoid"
                         material="MonsterPlaceholder" uResolution="12" vResolution="6"
                         castShadows="true" visible="true">
        <param name="xRadius" value="0.8"/>
        <param name="yRadius" value="0.8"/>
        <param name="zRadius" value="0.8"/>
        <param name="n1" value="0.1"/>
        <param name="n2" value="0.1"/>
      </parametricSurface>
      <userData>
        <property name="mass" type="float" data="0"/>
        <property name="collider" type="string" data="box"/>
        <property name="physics_enabled" type="bool" data="false"/>
      </userData>
    </node>

  </nodes>
</scene>

